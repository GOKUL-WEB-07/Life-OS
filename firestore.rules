rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsExisting() { return signedIn() && resource.data.userId == request.auth.uid; }
    function ownsNew() { return signedIn() && request.resource.data.userId == request.auth.uid; }
    function auditCreate() { return request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time; }
    function auditUpdate() { return request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time; }
    function validText(value) { return value is string && value.size() > 0 && value.size() <= 300; }
    function validDate(value) { return value is string && (value == '' || value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
    function validPriority(value) { return value in ['high', 'medium', 'low']; }
    function ownsArea(id) { return id is string && exists(/databases/$(database)/documents/areas/$(id)) && get(/databases/$(database)/documents/areas/$(id)).data.userId == request.auth.uid; }
    function ownsProject(id) { return id is string && exists(/databases/$(database)/documents/projects/$(id)) && get(/databases/$(database)/documents/projects/$(id)).data.userId == request.auth.uid; }
    function validSubtask(item) { return item is map && item.keys().hasOnly(['id','title','completed']) && validText(item.id) && validText(item.title) && item.completed is bool; }
    function validSubtasks(d) { let items = d.get('subtasks', []); return items is list && items.size() <= 20 && (items.size() <= 0 || validSubtask(items[0]))
        && (items.size() <= 1 || validSubtask(items[1]))
        && (items.size() <= 2 || validSubtask(items[2]))
        && (items.size() <= 3 || validSubtask(items[3]))
        && (items.size() <= 4 || validSubtask(items[4]))
        && (items.size() <= 5 || validSubtask(items[5]))
        && (items.size() <= 6 || validSubtask(items[6]))
        && (items.size() <= 7 || validSubtask(items[7]))
        && (items.size() <= 8 || validSubtask(items[8]))
        && (items.size() <= 9 || validSubtask(items[9]))
        && (items.size() <= 10 || validSubtask(items[10]))
        && (items.size() <= 11 || validSubtask(items[11]))
        && (items.size() <= 12 || validSubtask(items[12]))
        && (items.size() <= 13 || validSubtask(items[13]))
        && (items.size() <= 14 || validSubtask(items[14]))
        && (items.size() <= 15 || validSubtask(items[15]))
        && (items.size() <= 16 || validSubtask(items[16]))
        && (items.size() <= 17 || validSubtask(items[17]))
        && (items.size() <= 18 || validSubtask(items[18]))
        && (items.size() <= 19 || validSubtask(items[19])); }
    function validTask(d) {
      return validText(d.title) && validPriority(d.priority) && validSubtasks(d)
        && d.status in ['todo', 'in-progress', 'blocked', 'done']
        && d.completed is bool && d.completed == (d.status == 'done')
        && (d.completed ? d.completedAt is timestamp : d.completedAt == null)
        && validDate(d.dueDate) && validDate(d.scheduledDate)
        && d.estimatedMinutes is number && d.estimatedMinutes >= 0 && d.estimatedMinutes <= 1440
        && (d.areaId == '' || ownsArea(d.areaId))
        && (d.projectId == '' || (ownsProject(d.projectId) && d.areaId == get(/databases/$(database)/documents/projects/$(d.projectId)).data.areaId));
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && auditCreate();
      allow update: if signedIn() && request.auth.uid == uid && auditUpdate();
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /areas/{id} {
      function valid() { return validText(request.resource.data.name) && request.resource.data.archived is bool && request.resource.data.order is number; }
      allow read: if ownsExisting();
      allow create: if ownsNew() && auditCreate() && valid();
      allow update: if ownsExisting() && ownsNew() && auditUpdate() && valid();
      allow delete: if false;
    }
    match /projects/{id} {
      function valid() { let d = request.resource.data; return validText(d.name) && (d.areaId == '' || ownsArea(d.areaId)) && validPriority(d.priority) && d.status in ['planning', 'active', 'paused', 'completed', 'archived'] && validDate(d.startDate) && validDate(d.deadline); }
      allow read: if ownsExisting();
      allow create: if ownsNew() && auditCreate() && valid();
      allow update: if ownsExisting() && ownsNew() && auditUpdate() && valid();
      allow delete: if false;
    }
    match /tasks/{id} {
      allow read: if ownsExisting();
      allow create: if ownsNew() && auditCreate() && validTask(request.resource.data) && (!request.resource.data.completed || request.resource.data.completedAt == request.time);
      allow update: if ownsExisting() && ownsNew() && auditUpdate() && validTask(request.resource.data) && (!request.resource.data.completed || request.resource.data.completedAt == request.time || (resource.data.completed && request.resource.data.completedAt == resource.data.completedAt));
      allow delete: if ownsExisting();
    }
    match /inboxItems/{id} {
      function valid() { return validText(request.resource.data.text) && request.resource.data.type == 'unprocessed'; }
      allow read, delete: if ownsExisting();
      allow create: if ownsNew() && auditCreate() && valid();
      allow update: if ownsExisting() && ownsNew() && auditUpdate() && valid();
    }
    match /calendarEvents/{id} {
      function valid() { let d = request.resource.data; return validText(d.title) && validDate(d.date) && d.date != '' && d.allDay is bool; }
      allow read, delete: if ownsExisting();
      allow create: if ownsNew() && auditCreate() && valid();
      allow update: if ownsExisting() && ownsNew() && auditUpdate() && valid();
    }
    match /reminders/{id} {
      function valid() { let d = request.resource.data; return validText(d.title) && validDate(d.date) && d.date != '' && d.completed is bool; }
      allow read, delete: if ownsExisting();
      allow create: if ownsNew() && auditCreate() && valid();
      allow update: if ownsExisting() && ownsNew() && auditUpdate() && valid();
    }
    match /{module}/{id} {
      function supported() { return module in ['subscriptions','documents','notes','ideas','bills']; }
      function valid() { let d = request.resource.data; return validText(d.title) && d.description is string && d.description.size() <= 5000
        && (module != 'subscriptions' || (d.amount is number && d.amount >= 0 && d.currency in ['INR','USD','EUR','GBP'] && d.cycle in ['monthly','yearly','quarterly','weekly','once'] && d.active is bool && validDate(d.date) && d.date != '' && d.reminderDays is int && d.reminderDays >= 0 && d.reminderDays <= 365))
        && (module != 'documents' || (validDate(d.date) && d.location is string && d.reference is string && d.reminderDays is int && d.reminderDays >= 0 && d.reminderDays <= 365))
        && (!(module in ['notes','ideas']) || (d.stage in ['seed','exploring','ready'] && d.archived is bool))
        && (module != 'bills' || (d.amount is number && d.amount >= 0 && d.currency in ['INR','USD','EUR','GBP'] && validDate(d.date) && d.date != '' && d.completed is bool)); }
      allow read, delete: if supported() && ownsExisting();
      allow create: if supported() && ownsNew() && auditCreate() && valid();
      allow update: if supported() && ownsExisting() && ownsNew() && auditUpdate() && valid();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
