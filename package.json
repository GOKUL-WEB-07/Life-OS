{
  "name": "life-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader runner",
    "build": "tsc -b \u0026\u0026 vite build --configLoader runner",
    "preview": "vite preview --host 127.0.0.1 --configLoader runner",
    "test": "vitest run --configLoader runner",
    "test:rules": "node --test tests/rules.test.mjs",
    "format": "prettier --write src tests *.ts *.json *.md",
    "build:pages": "node scripts/build-pages.mjs",
    "predev": "node scripts/prepare-fonts.mjs",
    "prebuild": "node scripts/prepare-fonts.mjs",
    "prebuild:pages": "node scripts/prepare-fonts.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "firebase": "12.19.0",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "prettier": "3.9.9"
  },
  "overrides": {
    "@types/node": "24.13.6"
  }
}
